@model CatalogViewModel
@{
    var hasArtist = !string.IsNullOrEmpty(Model.Artist);
    var artistHeading = $"Bài hát của {Model.Artist}";
    ViewData["Title"] = hasArtist ? artistHeading : "Khám phá";
    var hasFilter = hasArtist || !string.IsNullOrWhiteSpace(Model.Query) || Model.GenreId.HasValue;
}
@if (!hasArtist)
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">YOUR DAILY SOUNDTRACK</p>
            <h1>Chào ngày mới<span class="accent">.</span></h1>
        </div>
        <span class="heading-note"><span class="status-dot"></span> Không gian âm nhạc của bạn</span>
    </div>
    <section class="hero" aria-labelledby="hero-title">
        <div class="hero-content">
            <span class="pill">TÌM MỘT NHỊP ĐIỆU RIÊNG</span>
            <h2 id="hero-title">Lắng nghe.<br />Cảm nhận.<br /><em>Kết nối.</em></h2>
            <p>Những giai điệu nhẹ nhàng cho một ngày đầy cảm hứng.<br class="desktop-break" /> Khám phá âm nhạc cùng Soul Signal.</p>
            <a class="button button-primary" href="#catalog">
                Khám phá bài hát <svg class="icon"><use href="#i-arrow" /></svg>
            </a>
        </div>
        <div class="hero-art" aria-hidden="true">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit orbit-three"></div>
            <div class="record">
                <div class="record-label">
                    <span class="record-logo">ss.</span>
                    <span>SOUL SIGNAL<br />FIND YOUR FREQUENCY</span>
                </div>
            </div>
            <div class="art-caption"><span>FEEL THE FREQUENCY</span><span>01 — 03</span></div>
        </div>
    </section>
}
<section id="catalog" class="catalog-section @(hasArtist ? "mt-0" : null)" aria-labelledby="catalog-title">
    <div class="section-heading">
        @if (hasArtist)
        {
            <h1 id="catalog-title">@artistHeading</h1>
        }
        else
        {
            <div>
                <p class="eyebrow">CHỌN MỘT GIAI ĐIỆU</p>
                <h2 id="catalog-title">@(hasFilter ? "Kết quả tìm kiếm" : "Giai điệu dành cho bạn")</h2>
            </div>
        }
        <span class="result-count">@Model.Songs.Count bài hát</span>
    </div>
    <form class="filter-bar" method="get" asp-controller="Home" asp-action="Index" asp-fragment="catalog">
        <input type="hidden" name="q" value="@Model.Query" />
        @if (hasArtist)
        {
            <input type="hidden" name="artist" value="@Model.Artist" />
        }
        <div class="filter-control">
            <label for="genre-filter">Thể loại</label>
            <select id="genre-filter" name="genreId">
                <option value="">Tất cả thể loại</option>
                @foreach (var genre in Model.Genres)
                {
                    <option value="@genre.Id" selected="@(Model.GenreId == genre.Id)">@genre.Name</option>
                }
            </select>
            <button class="button button-small button-muted" type="submit">Lọc</button>
        </div>
        @if (hasFilter)
        {
            <div class="filter-summary">
                @if (!string.IsNullOrWhiteSpace(Model.Query))
                {
                    <span>“@Model.Query”</span>
                }
                <a asp-controller="Home" asp-action="Index" asp-fragment="catalog">Xóa bộ lọc ×</a>
            </div>
        }
        else
        {
            <span class="filter-hint">Bản phát hành đã duyệt · Nghe trực tiếp</span>
        }
    </form>
    @if (Model.Songs.Count == 0)
    {
        <div class="empty-state">
            <svg class="icon"><use href="#i-search" /></svg>
            <h3>Chưa tìm thấy giai điệu phù hợp</h3>
            <p>Thử tên bài hát, nghệ sĩ hoặc một thể loại khác nhé.</p>
            <a class="button button-outline" asp-controller="Home" asp-action="Index">Xem tất cả bài hát</a>
        </div>
    }
    else
    {
        <div class="song-grid">
            @foreach (var song in Model.Songs)
            {
                var hasFlac = Model.FlacSongIds.Contains(song.Id);
                var canStreamFlac = hasFlac && Model.HasActiveVip;
                <article class="song-card">
                    <div class="song-card-art">
                        <a class="song-cover-link" asp-controller="Songs" asp-action="Details"
                           asp-route-id="@song.Id" aria-label="Chi tiết @song.Title">
                            <img class="song-cover" src="@song.CoverPath" alt="Ảnh bìa @song.Title"
                                 width="480" height="480" loading="lazy" />
                            <span class="cover-genre">@song.Genre.Name</span>
                        </a>
                        <partial name="_PlaybackLink" model="new PlaybackLinkViewModel(song, canStreamFlac, canStreamFlac && song.AllowDownload, Compact: true, HasFlac: hasFlac, IsFavorite: Model.FavoriteSongIds.Contains(song.Id))" />
                    </div>
                    <div class="song-info">
                        <div>
                            <h3><a asp-controller="Songs" asp-action="Details" asp-route-id="@song.Id" title="@song.Title">@song.Title</a></h3>
                            <p>
                                <a class="artist-link" asp-controller="Home" asp-action="Index" asp-route-artist="@song.Artist"
                                   asp-fragment="catalog" title="@song.Artist">@song.Artist</a>
                            </p>
                        </div>
                        <span class="song-duration">@($"{song.DurationSeconds / 60}:{song.DurationSeconds % 60:00}")</span>
                    </div>
                </article>
            }
        </div>
    }
</section>
<section class="experience-strip" aria-label="Trải nghiệm Soul Signal">
    <div class="experience-icon"><svg class="icon"><use href="#i-headphones" /></svg></div>
    <div>
        <h2>Âm nhạc ở đây. Khoảnh khắc là của bạn.</h2>
        <p>Bấm Phát để nghe và điều khiển bài hát từ thanh ở cuối màn hình.</p>
    </div>
    <a asp-controller="Home" asp-action="Scope" class="inline-link">Về bản trải nghiệm <span>↗</span></a>
</section>
