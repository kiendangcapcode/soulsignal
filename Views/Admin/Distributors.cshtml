@model IReadOnlyList<Distributor>
@{
    ViewData["Title"] = "Nguồn phân phối";
}
<a class="back-link" asp-controller="Admin" asp-action="Index">← Tổng quan quản trị</a>
<div class="page-heading">
    <div>
        <p class="eyebrow">DỮ LIỆU NGUỒN NHẠC</p>
        <h1>Nguồn phân phối<span class="accent">.</span></h1>
    </div>
    <span class="pill pill-muted">ĐƠN VỊ GIẢ LẬP</span>
</div>
<p class="page-description">Mỗi đơn vị giả lập có tài khoản riêng để gửi nhạc và quản lý danh mục của mình.
    Admin duyệt bài gửi lên trước khi bài xuất hiện ở trang nghe nhạc.</p>
<div class="role-grid">
    @foreach (var distributor in Model)
    {
        <article class="role-card" data-distributor-id="@distributor.Id">
            <svg class="icon"><use href="#i-music" /></svg>
            <h2>@distributor.Name</h2>
            <p class="eyebrow">@distributor.Code · @(distributor.IsSimulation ? "GIẢ LẬP" : "NGUỒN DỮ LIỆU")</p>
            <p>@distributor.Description</p>
        </article>
    }
</div>
<div class="notice notice-roadmap">
    <svg class="icon"><use href="#i-info" /></svg>
    <div>
        <strong>Nguồn phân phối dùng cho demo</strong>
        <p>Các đơn vị và tài khoản trong danh sách mô phỏng luồng nhận gói nhạc của Soul Signal.</p>
    </div>
</div>
<a class="button button-primary" asp-controller="Admin" asp-action="Index">Về danh mục xét duyệt <span>↗</span></a>
