@model SongDetailsViewModel
@inject IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = Model.Song.Title;
    var song = Model.Song;
    var canSeeInternal = User.IsInRole(AppRoles.Admin);
    var offerVip = song.Status == SongStatus.Approved && Model.HasFlac && !Model.CanStreamFlac
        && (User.IsInRole(AppRoles.Listener) || User.Identity?.IsAuthenticated != true);
    var mp3Url = Url.Action("Stream", "Songs", new { id = song.Id });
    var quality = Model.CanStreamFlac ? "Có bản FLAC · VIP"
        : string.IsNullOrEmpty(song.HighQualityFileName) ? "MP3 · Chất lượng thường" : "MP3 · 128 kbps";
}
<a class="back-link" asp-controller="Home" asp-action="Index">← Trở về khám phá</a>
<section class="track-detail" aria-labelledby="track-title">
    <div class="track-art">
        <img src="@song.CoverPath" alt="Ảnh bìa @song.Title" width="600" height="600" />
    </div>
    <div class="track-content">
        <p class="eyebrow">BÀI HÁT · @song.Genre.Name.ToUpperInvariant()</p>
        <h1 id="track-title">@song.Title</h1>
        <p class="track-artist">
            <a class="artist-link" asp-controller="Home" asp-action="Index" asp-route-artist="@song.Artist"
               asp-fragment="catalog">@song.Artist</a>
        </p>
        <div class="track-meta">
            <span><svg class="icon"><use href="#i-clock" /></svg>@($"{song.DurationSeconds / 60}:{song.DurationSeconds % 60:00}")</span>
            <span class="meta-separator">·</span>
            <span data-quality-fallback>@quality</span>
            <partial name="_QualityPicker" model="false" />
        </div>
        @if (!string.IsNullOrWhiteSpace(song.Description))
        {
            <p class="track-description">@song.Description</p>
        }
        <div class="track-actions">
            <audio id="track-audio" data-player-native controls controlslist="nodownload" preload="none"
                   aria-label="Nghe @song.Title"
                   src="@(Model.CanStreamFlac ? null : mp3Url)">
                @if (Model.CanStreamFlac)
                {
                    <source src="@Url.Action("StreamFlac", "Songs", new { id = song.Id })" type="audio/flac" />
                    <source src="@mp3Url" type="audio/mpeg" />
                }
                Trình duyệt của bạn chưa hỗ trợ phát âm thanh.
            </audio>
            <partial name="_PlaybackLink" model="new PlaybackLinkViewModel(song, Model.CanStreamFlac, Model.CanDownloadFlac, Compact: false, HasFlac: Model.HasFlac, IsFavorite: Model.IsFavorite)" />
            @if (song.Status == SongStatus.Approved && (User.IsInRole(AppRoles.Listener) || User.Identity?.IsAuthenticated != true))
            {
                <div data-detail-favorite>
                    <partial name="_FavoriteToggle" model="((int?)song.Id, song.Title, Model.IsFavorite)" />
                </div>
            }
            @if (Model.CanDownloadFlac)
            {
                <a class="button button-outline track-download" asp-controller="Songs" asp-action="Download"
                   asp-route-id="@song.Id">
                    <svg class="icon" aria-hidden="true"><use href="#i-player-download" /></svg>
                    Tải FLAC
                </a>
            }
        </div>
        @if (canSeeInternal || User.IsInRole(AppRoles.Distributor))
        {
            <div class="publisher-credit">
                <span class="credit-icon"><svg class="icon"><use href="#i-music" /></svg></span>
                <div>
                    <small>NGUỒN PHÂN PHỐI · GIẢ LẬP</small>
                    <strong>@(song.Distributor?.Name ?? "Nguồn demo")</strong>
                </div>
                @if (song.Status == SongStatus.Approved)
                {
                    <span class="badge rounded-pill badge-approved">Đã duyệt</span>
                }
                else if (song.Status == SongStatus.Pending)
                {
                    <span class="badge rounded-pill badge-pending">Chờ duyệt · Nội bộ</span>
                }
                else
                {
                    <span class="badge rounded-pill badge-rejected">Từ chối · Nội bộ</span>
                }
            </div>
        }
    </div>
</section>
<section class="detail-bottom @(offerVip ? "" : "d-block")">
    <div>
        <p class="eyebrow">THÔNG TIN BÀI HÁT</p>
        <h2>@song.Title</h2>
        @if (!string.IsNullOrWhiteSpace(song.Description))
        {
            <p>@song.Description</p>
        }
        @if (canSeeInternal)
        {
            <details class="demo-accounts">
                <summary>Thông tin xét duyệt và quyền sử dụng · Nội bộ</summary>
                <dl class="information-list">
                    <div><dt>Chủ thể quyền / đơn vị ủy quyền</dt><dd>@song.RightsHolder</dd></div>
                    <div><dt>Căn cứ quyền sử dụng</dt><dd class="preserve-lines">@song.RightsEvidence</dd></div>
                    <div><dt>Mã bản ghi nguồn giả lập</dt><dd>@(song.ExternalRecordingCode ?? "Không cung cấp")</dd></div>
                    <div><dt>Mã gói nguồn giả lập</dt><dd>@(song.ExternalReleaseCode ?? "Không cung cấp")</dd></div>
                    <div>
                        <dt>Phản hồi xét duyệt</dt>
                        <dd class="preserve-lines">@(song.ReviewNote ?? (song.Status == SongStatus.Pending ? "Đang chờ admin kiểm tra." : "Chưa có ghi chú bổ sung."))</dd>
                    </div>
                </dl>
            </details>
        }
        @if (HostEnvironment.IsDevelopment() && !string.IsNullOrEmpty(song.FlacFileName)
            && canSeeInternal)
        {
            <details class="demo-accounts">
                <summary>Kiểm tra kỹ thuật FLAC · Chỉ dành cho bản phát triển</summary>
                <p>Quản trị viên có thể nghe thử tệp FLAC trong môi trường phát triển.</p>
                <audio controls preload="none" aria-label="Kiểm tra phát FLAC" src="@Url.Action("FlacPreview", "Songs", new { id = song.Id })">
                    Trình duyệt của bạn chưa hỗ trợ phát tệp này.
                </audio>
            </details>
        }
    </div>
    @if (offerVip)
    {
        <aside class="future-card">
            <span class="pill pill-muted">SOUL SIGNAL VIP</span>
            <h3>Nghe bản FLAC với VIP</h3>
            <p>Kích hoạt gói VIP mô phỏng để nghe bản FLAC của bài hát này.</p>
            <a class="inline-link" asp-controller="Vip" asp-action="Index">Xem gói VIP ↗</a>
        </aside>
    }
</section>
