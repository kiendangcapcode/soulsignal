<section class="site-player" data-site-player hidden aria-label="Thanh phát nhạc">
    <div class="player-track">
        <img data-player-cover alt="" width="52" height="52" />
        <div class="player-track-text">
            <a data-player-title></a>
            <span data-player-artist></span>
        </div>
        @if (User.IsInRole(AppRoles.Listener) || User.Identity?.IsAuthenticated != true)
        {
            <div data-player-favorite>
                <partial name="_FavoriteToggle" model="((int?)null, (string?)null, false)" />
            </div>
        }
    </div>
    <div class="player-transport">
        <button type="button" class="player-icon" data-player-prev disabled aria-label="Bài trước" title="Bài trước">
            <svg class="icon" aria-hidden="true"><use href="#i-player-prev" /></svg>
        </button>
        <button type="button" class="player-icon player-main" data-player-toggle aria-label="Phát" title="Phát">
            <svg class="icon" aria-hidden="true"><use href="#i-player-play" /></svg>
        </button>
        <button type="button" class="player-icon" data-player-next disabled aria-label="Bài sau" title="Bài sau">
            <svg class="icon" aria-hidden="true"><use href="#i-player-next" /></svg>
        </button>
    </div>
    <div class="player-timeline">
        <span data-player-elapsed>0:00</span>
        <input class="player-range" data-player-seek type="range" min="0" max="0" value="0" step="0.1"
               disabled aria-label="Vị trí phát" />
        <span data-player-duration>0:00</span>
    </div>
    <div class="player-tools">
        <partial name="_QualityPicker" model="true" />
        <a class="player-icon" data-player-download hidden aria-label="Tải FLAC" title="Tải FLAC">
            <svg class="icon" aria-hidden="true"><use href="#i-player-download" /></svg>
        </a>
        <div class="player-volume">
            <button type="button" class="player-icon" data-player-mute aria-label="Tắt tiếng" title="Tắt tiếng">
                <svg class="icon" aria-hidden="true"><use href="#i-player-volume" /></svg>
            </button>
            <input class="player-range" data-player-volume type="range" min="0" max="1" value="1" step="0.01"
                   aria-label="Âm lượng" />
        </div>
        <button type="button" class="player-icon" data-player-close aria-label="Đóng thanh phát" title="Đóng thanh phát">
            <svg class="icon" aria-hidden="true"><use href="#i-player-close" /></svg>
        </button>
    </div>
    <audio data-player-audio preload="none" controlslist="nodownload"></audio>
</section>
@if (User.IsInRole(AppRoles.Listener))
{
    <div class="favorite-status" data-favorite-status role="status"></div>
}
